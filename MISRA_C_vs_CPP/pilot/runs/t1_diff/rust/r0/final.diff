+fn diff(a: &[i64], b: &[i64]) -> usize {
+    let (mut i, mut j, mut c) = (0usize, 0usize, 0usize);
+    while i < a.len() && j < b.len() {
+        let (x, y) = (a[i], b[j]);
+        if x == y { i += 1; j += 1; }
+        else if x < y { c += 1; i += 1; }
+        else { j += 1; }
+    }
+    c += a.len() - i;
+    c
+}
