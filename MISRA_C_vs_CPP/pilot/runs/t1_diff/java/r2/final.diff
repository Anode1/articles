@@ -63,4 +72,14 @@ public class Bench {
     }
     return c;
   }
+
+  static int diff(long[] A, long[] B) {
+    int i=0,j=0,c=0;
+    while (i<A.length && j<B.length) {
+      long x=A[i], y=B[j];
+      if (x==y){i++;j++;} else if (x<y){c++;i++;} else j++;
+    }
+    c += A.length - i;
+    return c;
+  }
 }
