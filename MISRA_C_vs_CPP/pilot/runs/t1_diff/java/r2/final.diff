@@ -26,6 +27,14 @@ public class Bench {
         System.out.printf("and   iter%d  %6.1f ms  common=%d  |A|=%d |B|=%d%n",
                           it, (System.nanoTime()-t0)/1e6, c, A.length, B.length);
