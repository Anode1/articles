--- a/bench.adb
+++ b/bench.adb
@@ -94,6 +94,19 @@ procedure Bench is
       return C;
    end Intersect;
 
+   function Diff (A : Id_Array; NA : Natural; B : Id_Array; NB : Natural) return Natural is
+      I : Natural := 0; J : Natural := 0; C : Natural := 0;
+   begin
+      while I < NA and then J < NB loop
+         if A (I) = B (J) then I := I + 1; J := J + 1;
+         elsif A (I) < B (J) then C := C + 1; I := I + 1;
+         else J := J + 1;
+         end if;
+      end loop;
+      C := C + (NA - I);
+      return C;
+   end Diff;
+
    procedure Row (Tag : String; It : Natural; T0 : Time; Extra : String) is
       US : constant Integer := Integer (Float (To_Duration (Clock - T0)) * 1_000_000.0);
    begin
