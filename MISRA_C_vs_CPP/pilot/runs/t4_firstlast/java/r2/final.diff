+  static long[] firstLast(long[] A, long[] B) {
+    int i=0,j=0; long first=0,last=0; boolean any=false;
+    while (i<A.length && j<B.length) {
+      long x=A[i], y=B[j];
+      if (x==y){ if(!any){first=x;any=true;} last=x; i++; j++; }
+      else if (x<y) i++; else j++;
+    }
+    return any ? new long[]{first,last} : null;
+  }
