+   procedure Intersect_Bounds (A : Id_Array; NA : Natural; B : Id_Array; NB : Natural;
+                               Found : out Boolean; First, Last : out Long_Long_Integer) is
+      I : Natural := 0; J : Natural := 0;
+   begin
+      Found := False;
+      First := 0;
+      Last  := 0;
+      while I < NA and then J < NB loop
+         if A (I) = B (J) then
+            if not Found then First := A (I); Found := True; end if;
+            Last := A (I);
+            I := I + 1; J := J + 1;
+         elsif A (I) < B (J) then I := I + 1;
+         else J := J + 1;
+         end if;
+      end loop;
+   end Intersect_Bounds;
