+   procedure Print_First_Last (A : Id_Array; NA : Natural; B : Id_Array; NB : Natural) is
+      I     : Natural := 0;
+      J     : Natural := 0;
+      Found : Boolean := False;
+      First : Long_Long_Integer := 0;
+      Last_Id : Long_Long_Integer := 0;
+   begin
+      while I < NA and then J < NB loop
+         if A (I) = B (J) then
+            if not Found then First := A (I); Found := True; end if;
+            Last_Id := A (I);
+            I := I + 1; J := J + 1;
+         elsif A (I) < B (J) then I := I + 1;
+         else J := J + 1;
+         end if;
+      end loop;
+      if Found then
+         Put_Line ("first=" & Img (First) & " last=" & Img (Last_Id));
+      else
+         Put_Line ("first=none last=none");
+      end if;
+   end Print_First_Last;
