+   function To_Lower (B : Stream_Element) return Stream_Element is
+      Upper_A : constant Stream_Element := Character'Pos ('A');
+      Upper_Z : constant Stream_Element := Character'Pos ('Z');
+   begin
+      if B >= Upper_A and then B <= Upper_Z then
+         return B + (Character'Pos ('a') - Character'Pos ('A'));
+      else
+         return B;
+      end if;
+   end To_Lower;
+
    function Count_Lines (S : Stream_Element_Array; Last : Stream_Element_Offset;
                          Pat : Stream_Element_Array) return Natural is
       Hits : Natural := 0;
