{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012rHjNp12gXQt2q71ScPbq4","type":"tool_result","content":"1\t/* store.c -- a small record-store front end. C99, no dependencies. */\n2\t#include <stdio.h>\n3\t#include <stdlib.h>\n4\t#include <string.h>\n5\t\n6\t/* Each operation returns the number of records it touched, or -1. */\n7\tstatic long store_add(const char *arg) { return (long)(strlen(arg) + 0); }\n8\t\n9\t\n10\t/* add: add records matching the argument */\n11\tstatic int cmd_add(int argc, char **argv)\n12\t{\n13\t    long n;\n14\t\n15\t    if (argc < 1) {\n16\t        fprintf(stderr, \"add: needs an argument\\n\");\n17\t        return 2;\n18\t    }\n19\t    n = store_add(argv[0]);\n20\t    if (n < 0) {\n21\t        fprintf(stderr, \"add: failed\\n\");\n22\t        return 1;\n23\t    }\n24\t    printf(\"add ok=1 n=%ld\\n\", n);\n25\t    return 0;\n26\t}\n27\t\n28\t\n29\tstruct entry { const char *name; int (*fn)(int, char **); };\n30\t\n31\tstatic const struct entry table[] = {\n32\t    { \"add\", cmd_add },\n33\t    { NULL, NULL }\n34\t};\n35\t\n36\tint main(int argc, char **argv)\n37\t{\n38\t    int i;\n39\t\n40\t    if (argc < 2) {\n41\t        fprintf(stderr, \"usage: store COMMAND ARG\\n\");\n42\t        return 2;\n43\t    }\n44\t    for (i = 0; table[i].name; i++)\n45\t        if (strcmp(table[i].name, argv[1]) == 0)\n46\t            return table[i].fn(argc - 2, argv + 2);\n47\t    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n48\t    return 2;\n49\t}\n50\t"}]},"parent_tool_use_id":null,"session_id":"4ceebb0b-bf69-41e6-bd54-cfc5f0a385c5","uuid":"a6a20c16-3603-410c-867e-fdc108c5086e","timestamp":"2026-08-25T02:08:01.604Z","tool_use_result":{"type":"text","file":{"filePath":"/home/vas/articles/MISRA_C_vs_CPP/sites/runs/rep1/r0/work/store.c","content":"/* store.c -- a small record-store front end. C99, no dependencies. */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/* Each operation returns the number of records it touched, or -1. */\nstatic long store_add(const char *arg) { return (long)(strlen(arg) + 0); }\n\n\n/* add: add records matching the argument */\nstatic int cmd_add(int argc, char **argv)\n{\n    long n;\n\n    if (argc < 1) {\n        fprintf(stderr, \"add: needs an argument\\n\");\n        return 2;\n    }\n    n = store_add(argv[0]);\n    if (n < 0) {\n        fprintf(stderr, \"add: failed\\n\");\n        return 1;\n    }\n    printf(\"add ok=1 n=%ld\\n\", n);\n    return 0;\n}\n\n\nstruct entry { const char *name; int (*fn)(int, char **); };\n\nstatic const struct entry table[] = {\n    { \"add\", cmd_add },\n    { NULL, NULL }\n};\n\nint main(int argc, char **argv)\n{\n    int i;\n\n    if (argc < 2) {\n        fprintf(stderr, \"usage: store COMMAND ARG\\n\");\n        return 2;\n    }\n    for (i = 0; table[i].name; i++)\n        if (strcmp(table[i].name, argv[1]) == 0)\n            return table[i].fn(argc - 2, argv + 2);\n    fprintf(stderr, \"unknown command: %s\\n\", argv[1]);\n    return 2;\n}\n","numLines":50,"startLine":1,"totalLines":50}}}
